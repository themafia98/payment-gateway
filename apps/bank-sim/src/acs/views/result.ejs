<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Authentication <%= approved ? 'complete' : 'failed' %></title>
    <style>
      body { margin:0; min-height:100vh; display:grid; place-items:center;
        color: <%= approved ? '#4ade80' : '#f87171' %>;
        background:#0f1117; font:16px system-ui, sans-serif; text-align:center; }
    </style>
  </head>
  <body>
    <div>
      <%= approved ? '✓ Authentication complete.' : '✕ Authentication failed.' %>
      <br /><small>Returning to merchant…</small>
    </div>
    <script nonce="<%= nonce %>">
      // Post the Challenge Response (cres) to the parent. transStatus only — never the OTP.
      window.parent.postMessage(<%- JSON.stringify(message) %>, <%- JSON.stringify(PARENT_ORIGIN) %>);
    </script>
  </body>
</html>
