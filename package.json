{
  "name": "payment-gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pg/demo",
    "dev:mock": "npm run dev:mock -w @pg/demo",
    "dev:bank": "npm run dev -w @pg/bank-sim",
    "build": "npm run build -w @pg/demo",
    "build:mock": "npm run build:mock -w @pg/demo",
    "preview": "npm run preview -w @pg/demo",
    "preview:mock": "npm run preview:mock -w @pg/demo",
    "typecheck": "tsc -b",
    "test:e2e": "npm run test:e2e -w @pg/demo",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix-dangerously",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2"
  }
}
