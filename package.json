{
  "name": "payment-gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pg/demo",
    "dev:mock": "npm run dev:mock -w @pg/demo",
    "dev:bank": "npm run dev -w @pg/bank-sim",
    "build:packages": "tsdown && node scripts/add-ui-styles-export.mjs",
    "build": "npm run build:packages && npm run build -w @pg/demo",
    "build:mock": "npm run build:packages && npm run build:mock -w @pg/demo",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check:types": "node scripts/check-published-types.mjs",
    "preview": "npm run preview -w @pg/demo",
    "preview:mock": "npm run preview:mock -w @pg/demo",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @pg/demo",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix-dangerously",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "purity": "node scripts/check-core-purity.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.2",
    "happy-dom": "^20.14.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.14",
    "tsdown": "^0.16.5",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  }
}
