{
  "name": "@pg/conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The contract every payment plugin must satisfy, as a runnable vitest suite.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@pg/core": "*",
    "@pg/testing": "*",
    "msw": "^2.15.0",
    "vitest": "^5.0.0"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@pg/source": "./src/index.ts",
