{
  "name": "@checkout-kit/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless checkout core: domain vocabulary, the payment plugin contract, and an HTTP client with no opinions about payments.",
  "license": "Apache-2.0",
  "author": "themafia98",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themafia98/payment-gateway.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@checkout-kit/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./domain": {
      "@checkout-kit/source": "./src/domain/index.ts",
      "default": "./dist/domain/index.mjs"
    },
    "./engine": {
      "@checkout-kit/source": "./src/engine/index.ts",
      "default": "./dist/engine/index.mjs"
    },
    "./http": {
      "@checkout-kit/source": "./src/http/index.ts",
      "default": "./dist/http/index.mjs"
    },
    "./provider": {
      "@checkout-kit/source": "./src/provider/index.ts",
      "default": "./dist/provider/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./domain": "./dist/domain/index.mjs",
      "./engine": "./dist/engine/index.mjs",
      "./http": "./dist/http/index.mjs",
      "./provider": "./dist/provider/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@checkout-kit/testing": "*"
  }
}
