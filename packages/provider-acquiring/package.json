{
  "name": "@pg/provider-acquiring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Payment plugin for direct bank acquiring: form-urlencoded host-to-host, numeric order statuses, 3-D Secure 1.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@pg/core": "*"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@pg/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@pg/conformance": "*",
    "@pg/testing": "*",
    "msw": "^2.15.0"
  }
}
