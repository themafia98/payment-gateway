{
  "name": "@checkout-kit/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React bindings for the checkout engine: a provider, hooks built on useSyncExternalStore, and a mount point for payment actions.",
  "license": "Apache-2.0",
  "author": "themafia98",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themafia98/payment-gateway.git",
    "directory": "packages/react"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@checkout-kit/core": "*",
    "@checkout-kit/runtime-browser": "*",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@checkout-kit/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
