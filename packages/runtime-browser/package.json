{
  "name": "@pg/runtime-browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser half of the checkout: the runners that actually execute payment actions - iframes, top-level redirects, postMessage - plus session storage.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@pg/core": "*"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@pg/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
