{
  "name": "@checkout-kit/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared test material: the card table every provider is exercised with, and an in-memory payment backend built on MSW.",
  "license": "Apache-2.0",
  "author": "themafia98",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themafia98/payment-gateway.git",
    "directory": "packages/testing"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@checkout-kit/core": "*",
    "msw": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "msw": "^2.15.0"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@checkout-kit/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./backend": {
      "@checkout-kit/source": "./src/backend/index.ts",
      "default": "./dist/backend/index.mjs"
    },
    "./engine": {
      "@checkout-kit/source": "./src/engine/index.ts",
      "default": "./dist/engine/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./backend": "./dist/backend/index.mjs",
      "./engine": "./dist/engine/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
